# 复制本文件为 .env.local 并填入你自己的值。.env.local 不会被提交到 git。
# DeepSeek 开放平台创建的 API key
DEEPSEEK_API_KEY=
# 可选：模型名与接口地址（以 DeepSeek 官方文档为准）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：公开部署时设置访问口令；留空则不需要口令
ACCESS_CODE=
# 可选：开发者账号（可以查看、回复用户反馈），多个用逗号分隔
ADMIN_USERNAMES=
# 可选：用户数据库所在目录（默认 data/）
DATA_DIR=
